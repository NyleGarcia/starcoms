Meta.DisplayName=Star Comms Shard
Meta.Description=Self-hosted Star Comms shard (Star Citizen voice/radio). Requires an active Premium Shard and a scsh_ token from /star-shard-request.
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=nylegarcia
Meta.URL=https://star-comms.org/self-hosted-setup.html
Meta.DisplayImageSource=url:https://star-comms.org/favicon.ico
Meta.EndpointURIFormat=
Meta.ConfigManifest=starcommsconfig.json
Meta.MetaConfigManifest=starcommsmetaconfig.json
Meta.ConfigRoot=starcomms.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=3e0f7177-a158-4142-9f84-1358e1f1ba0d
Meta.ImportableExtensions=[]
App.DisplayName=Star Comms Shard
App.RootDir=./starcomms/
App.BaseDirectory=./starcomms/shard/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=bun/bin/bun
App.WorkingDir=shard
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=run starcomms-launcher.mjs
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"BUN_INSTALL":"{{$FullRootDir}}bun","PATH":"{{$FullRootDir}}bun/bin:%PATH%","STARCOMMS_CENTRAL_URL":"{{CentralUrl}}","STARCOMMS_SHARD_TOKEN":"{{ShardToken}}","STARCOMMS_SHARD_PUBLIC_URL":"{{PublicUrl}}","STARCOMMS_SHARD_UDP_PUBLIC_HOST":"{{UdpPublicHost}}","STARCOMMS_SHARD_NAME":"{{ShardName}}","STARCOMMS_SHARD_PORT":"{{$ShardPort}}","STARCOMMS_SHARD_UDP_VOICE_ENABLED":"{{UdpVoiceEnabled}}","STARCOMMS_SHARD_UDP_BIND":"{{$ApplicationIPBinding}}:{{$UdpVoicePort}}","STARCOMMS_SHARD_ARCHIVE_DRIVER":"{{ArchiveDriver}}","STARCOMMS_SHARD_AUTO_UPDATE":"false","STARCOMMS_LOG_LEVEL":"{{LogLevel}}","STARCOMMS_TLS_MODE":"{{TlsMode}}","STARCOMMS_TLS_PORT":"{{$TlsPort}}","STARCOMMS_TLS_DOMAIN":"{{TlsDomain}}","STARCOMMS_TLS_EMAIL":"{{TlsEmail}}","STARCOMMS_CF_TUNNEL_TOKEN":"{{CloudflareTunnelToken}}","STARCOMMS_CF_API_TOKEN":"{{CloudflareApiToken}}"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=exit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[starcommsports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ShardPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=0
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[starcommsupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.json","*.sqlite","*.env"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^.*Star Comms (Bun )?shard listening.*$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
