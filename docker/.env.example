# Copy to .env and fill in. Never commit .env (holds the shard token).

# From /star-shard-request in Discord (requires active Premium Shard).
STARCOMMS_SHARD_TOKEN=scsh_xxx
# Public URL that reaches this container; must serve /ws and /health.
STARCOMMS_SHARD_PUBLIC_URL=https://shard.example.com
# Public host/IP clients send UDP voice to (defaults to public URL host).
# STARCOMMS_SHARD_UDP_PUBLIC_HOST=203.0.113.10
STARCOMMS_SHARD_NAME=My Shard
STARCOMMS_SHARD_PORT=8787
# Bump to pull a newer shard script on next start.
STARCOMMS_SHARD_VERSION=1.0.116
